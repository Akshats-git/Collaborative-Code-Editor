# --- server (apps/server) ---
PORT=8080
INSTANCE_ID=local

# Relays edits between server instances. Unset means one instance: everything
# still works, but a client on one server never sees edits made on another.
REDIS_URL=
HEARTBEAT_INTERVAL_MS=30000

# Must be identical on every instance: nothing pins a client to the instance
# that issued its token. Unset means a random key per process.
AUTH_SECRET=change-me
AUTH_TTL_SECONDS=3600
AUTH_TIMEOUT_MS=5000
CORS_ORIGIN=*

# Unset means no durability: documents live only as long as the process.
DATABASE_URL=postgres://cce:cce@localhost:55432/cce

# How much editing a hard crash may lose, and when the update log gets folded
# back into a snapshot.
PERSIST_DEBOUNCE_MS=500
PERSIST_MAX_BATCH_BYTES=65536
COMPACT_AFTER_UPDATES=200

# --- tests ---
# Set to run the Postgres-backed suite; leave unset to skip it.
TEST_DATABASE_URL=postgres://cce:cce@localhost:55432/cce

# --- web (apps/web) ---
VITE_WS_URL=ws://localhost:8080
# Defaults to VITE_WS_URL with the scheme swapped to http.
VITE_API_URL=http://localhost:8080

# Per connection. Bursts of twice these rates are allowed.
RATE_LIMIT_BYTES_PER_SECOND=1048576
RATE_LIMIT_MIN_FRAME_COST=1024
RATE_LIMIT_PRESENCE_PER_SECOND=60

# How far behind a client's send buffer may fall. Past the soft limit its
# presence updates are dropped; past the hard one the socket is closed.
BACKPRESSURE_SOFT_BYTES=262144
BACKPRESSURE_HARD_BYTES=4194304
